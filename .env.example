APP_ENV=development
APP_NAME=dhan-algo-platform
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dhan_algo
REDIS_URL=redis://localhost:6379/0

MARKET_DATA_STALE_SECONDS=3

MAX_DAILY_LOSS=
MAX_TRADES_PER_DAY=
MAX_OPEN_POSITIONS=
MAX_ORDER_QUANTITY=

KILL_SWITCH_ENABLED=true

API_HOST=0.0.0.0
API_PORT=8000
