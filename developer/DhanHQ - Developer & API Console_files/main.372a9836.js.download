ers=headers)\n\n    if res.status_code != 200:\n        print(f"Error: {res.status_code} \u2014 {res.text}")\n        return\n\n    holdings = res.json()\n    if not holdings:\n        print("No holdings found.")\n        return\n\n    total_invested, total_current = 0, 0\n    print(f"{\'Symbol\':<15} {\'Qty\':>6} {\'Avg Price\':>10} {\'LTP\':>10} {\'P&L\':>12} {\'%\':>8}")\n    print("-" * 65)\n\n    for h in holdings:\n        qty = h.get("totalQty", 0)\n        avg = h.get("avgCostPrice", 0)\n        ltp = h.get("lastTradedPrice", 0)\n        invested = qty * avg\n        current = qty * ltp\n        pnl = current - invested\n        pct = (pnl / invested * 100) if invested else 0\n        total_invested += invested\n        total_current += current\n        symbol = h.get("tradingSymbol", "\u2014")\n        print(f"{symbol:<15} {qty:>6} {avg:>10.2f} {ltp:>10.2f} {pnl:>+12.2f} {pct:>+7.2f}%")\n\n    total_pnl = total_current - total_invested\n    total_pct = (total_pnl / total_invested * 100) if total_invested else 0\n    print("-" * 65)\n    print(f"{\'TOTAL\':<15} {\'\':>6} {\'\':>10} {\'\':>10} {total_pnl:>+12.2f} {total_pct:>+7.2f}%")\n\n    print(f"\\nTimestamp: {datetime.now().isoformat()}")\n\nif __name__ == "__main__":\n    main()',requirements:"requests==2.32.3"},{id:"order-placer",name:"Place Order via API",description:"Place a market or limit order on Dhan using the Orders API",iconKey:"send",category:"Trading",difficulty:"Intermediate",envVars:[{key:"ACCESS_TOKEN",value:""},{key:"CLIENT_ID",value:""}],code:'# Place Order via DhanHQ API\n# Places a single order \u2014 configure symbol, qty, price below\n# Set ACCESS_TOKEN and CLIENT_ID in Env Variables tab\n\nimport json\nimport requests\nfrom datetime import datetime\n\nACCESS_TOKEN = "{{ACCESS_TOKEN}}"\nCLIENT_ID = "{{CLIENT_ID}}"\nBASE_URL = "https://api.dhan.co/v2"\n\n# --- Order Configuration ---\nSECURITY_ID = "1333"        # HDFC Bank (NSE)\nEXCHANGE = "NSE"\nSEGMENT = "EQ"               # EQ = Equity\nTXN_TYPE = "BUY"            # BUY or SELL\nORDER_TYPE = "MARKET"       # MARKET or LIMIT\nPRODUCT_TYPE = "INTRADAY"   # INTRADAY, CNC, MARGIN\nQUANTITY = 1\nPRICE = 0                   # 0 for MARKET orders\n\ndef main():\n    headers = {"access-token": ACCESS_TOKEN, "Content-Type": "application/json"}\n\n    order = {\n        "dhanClientId": CLIENT_ID,\n        "transactionType": TXN_TYPE,\n        "exchangeSegment": f"{EXCHANGE}_{SEGMENT}",\n        "productType": PRODUCT_TYPE,\n        "orderType": ORDER_TYPE,\n        "validity": "DAY",\n        "securityId": SECURITY_ID,\n        "quantity": QUANTITY,\n        "price": PRICE,\n        "disclosedQuantity": 0,\n        "afterMarketOrder": False,\n    }\n\n    print(f"Placing {TXN_TYPE} {ORDER_TYPE} order for {QUANTITY} qty of {SECURITY_ID}...")\n    res = requests.post(f"{BASE_URL}/orders", headers=headers, json=order)\n\n    print(f"Status: {res.status_code}")\n    data = res.json()\n    print(f"Response: {json.dumps(data, indent=2)}")\n\n    if res.status_code == 200 and data.get("orderId"):\n        print(f"Order placed successfully. Order ID: {data[\'orderId\']}")\n    else:\n        print(f"Order failed: {data.get(\'remarks\', \'Unknown error\')}")\n\nif __name__ == "__main__":\n    main()',requirements:"requests==2.32.3"},{id:"positions-monitor",name:"Positions Monitor",description:"Fetch open positions and display real-time P&L summary",iconKey:"activity",category:"Portfolio",difficulty:"Beginner",envVars:[{key:"ACCESS_TOKEN",value:""},{key:"CLIENT_ID",value:""}],code:'# Positions Monitor\n# Fetches open positions from DhanHQ and shows P&L\n# Set ACCESS_TOKEN and CLIENT_ID in Env Variables tab\n\nimport json\nimport requests\nfrom datetime import datetime\n\nACCESS_TOKEN = "{{ACCESS_TOKEN}}"\nCLIENT_ID = "{{CLIENT_ID}}"\nBASE_URL = "https://api.dhan.co/v2"\n\ndef main():\n    headers = {"access-token": ACCESS_TOKEN, "Content-Type": "application/json"}\n\n    print("Fetching positions...")\n    res = requests.get(f"{BASE_URL}/positions", headers=headers)\n\n    if res.status_code != 200:\n        print(f"Error: {res.status_code} \u2014 {res.text}")\n        return\n\n    positions = res.json()\n    if not positions:\n        print("No open positions.")\n        return\n\n    total_pnl = 0\n    print(f"{\'Symbol\':<15} {\'Qty\':>6} {\'Buy Avg\':>10} {\'Sell Avg\':>10} {\'P&L\':>12}")\n    print("-" * 58)\n\n    for p in positions:\n        symbol = p.get("tradingSymbol", "\u2014")\n        buy_qty = p.get("buyQty", 0)\n        sell_qty = p.get("sellQty", 0)\n        net_qty = buy_qty - sell_qty\n        buy_avg = p.get("buyAvg", 0)\n        sell_avg = p.get("sellAvg", 0)\n        realized = p.get("realizedProfit", 0)\n        unrealized = p.get("unrealizedProfit", 0)\n        pnl = realized + unrealized\n        total_pnl += pnl\n        print(f"{symbol:<15} {net_qty:>6} {buy_avg:>10.2f} {sell_avg:>10.2f} {pnl:>+12.2f}")\n\n    print("-" * 58)\n    print(f"{\'TOTAL P&L\':<15} {\'\':>6} {\'\':>10} {\'\':>10} {total_pnl:>+12.2f}")\n    print(f"\\nTimestamp: {datetime.now().isoformat()}")\n\nif __name__ == "__main__":\n    main()',requirements:"requests==2.32.3"},{id:"order-book",name:"Order Book Viewer",description:"Fetch and display all orders placed today with status",iconKey:"list",category:"Trading",difficulty:"Beginner",envVars:[{key:"ACCESS_TOKEN",value:""},{key:"CLIENT_ID",value:""}],code:'# Order Book Viewer\n# Fetches today\'s orders from DhanHQ and displays status\n# Set ACCESS_TOKEN and CLIENT_ID in Env Variables tab\n\nimport json\nimport requests\nfrom datetime import datetime\n\nACCESS_TOKEN = "{{ACCESS_TOKEN}}"\nCLIENT_ID = "{{CLIENT_ID}}"\nBASE_URL = "https://api.dhan.co/v2"\n\ndef main():\n    headers = {"access-token": ACCESS_TOKEN, "Content-Type": "application/json"}\n\n    print("Fetching order book...")\n    res = requests.get(f"{BASE_URL}/orders", headers=headers)\n\n    if res.status_code != 200:\n        print(f"Error: {res.status_code} \u2014 {res.text}")\n        return\n\n    orders = res.json()\n    if not orders:\n        print("No orders found today.")\n        return\n\n    print(f"{\'Order ID\':<14} {\'Symbol\':<15} {\'Type\':<6} {\'Qty\':>5} {\'Price\':>10} {\'Status\':<12}")\n    print("-" * 68)\n\n    for o in orders:\n        oid = str(o.get("orderId", "\u2014"))[:12]\n        symbol = o.get("tradingSymbol", "\u2014")\n        txn = o.get("transactionType", "\u2014")\n        qty = o.get("quantity", 0)\n        price = o.get("price", 0)\n        status = o.get("orderStatus", "\u2014")\n        print(f"{oid:<14} {symbol:<15} {txn:<6} {qty:>5} {price:>10.2f} {status:<12}")\n\n    print(f"\\nTotal orders: {len(orders)}")\n    print(f"Timestamp: {datetime.now().isoformat()}")\n\nif __name__ == "__main__":\n    main()',requirements:"requests==2.32.3"},{id:"fund-balance",name:"Fund Balance Check",description:"Check available margin and fund limits from your Dhan account",iconKey:"indian-rupee",category:"Account",difficulty:"Beginner",envVars:[{key:"ACCESS_TOKEN",value:""},{key:"CLIENT_ID",value:""}],code:'# Fund Balance Check\n# Fetches fund limits from DhanHQ API\n# Set ACCESS_TOKEN and CLIENT_ID in Env Variables tab\n\nimport json\nimport requests\nfrom datetime import datetime\n\nACCESS_TOKEN = "{{ACCESS_TOKEN}}"\nCLIENT_ID = "{{CLIENT_ID}}"\nBASE_URL = "https://api.dhan.co/v2"\n\ndef main():\n    headers = {"access-token": ACCESS_TOKEN, "Content-Type": "application/json"}\n\n    print("Fetching fund limits...")\n    res = requests.get(f"{BASE_URL}/fundlimit", headers=headers)\n\n    if res.status_code != 200:\n        print(f"Error: {res.status_code} \u2014 {res.text}")\n        return\n\n    data = res.json()\n    if not data:\n        print("No fund data available.")\n        return\n\n    print(f"{\'Metric\':<30} {\'Value\':>15}")\n    print("-" * 48)\n\n    fields = [\n        ("Available Balance", "availabelBalance"),\n        ("Utilized Amount", "utilizedAmount"),\n        ("SOD Limit", "sodLimit"),\n        ("Collateral Amount", "collateralAmount"),\n        ("Receivable Amount", "receiveableAmount"),\n    ]\n\n    for label, key in fields:\n        val = data.get(key, 0)\n        print(f"{label:<30} {val:>15.2f}")\n\n    print(f"\\nTimestamp: {datetime.now().isoformat()}")\n\nif __name__ == "__main__":\n    main()',requirements:"requests==2.32.3"},{id:"hello-world",name:"Hello World",description:"Simple starter template to test your setup",iconKey:"terminal",category:"Starter",difficulty:"Beginner",envVars:[],code:'# Hello World \u2014 Starter Template\nimport json\nimport time\nfrom datetime import datetime\n\ndef main():\n    print("Hello from Dhan Cloud!")\n    print(f"Current time: {datetime.now().isoformat()}")\n\n    data = {"status": "success", "message": "Strategy executed!"}\n    print(f"Result: {json.dumps(data, indent=2)}")\n\nif __name__ == "__main__":\n    main()',requirements:""}],np={wallet:"data:image/png;base64,",send:"data:image/png;base64,",activity:"data:image/png;base64,",list:"data:image/png;base64,","indian-rupee":"data:image/png;base64,",terminal:"data:image/png;base64,"},ip=[".py",".txt",".json",".csv",".yaml",".yml",".toml",".cfg",".ini"];function op(t){let{icon:e,title:a,description:r,onStart:s,tags:n}=t;return(0,Me.jsxs)("div",{className:"flex-1 bg-dhq-sidebar border border-dhq-border rounded-lg p-[14px] flex items-start justify-between",children:[(0,Me.jsxs)("div",{className:"flex gap-[18px] items-start",children:[(0,Me.jsx)("div",{className:"w-12 h-12 border border-[#2d303d] rounded-lg overflow-hidden flex items-center justify-center flex-shrink-0",children:(0,Me.jsx)("img",{src:e,alt:"",className:"w-8 h-8"})}),(0,Me.jsxs)("div",{className:"flex flex-col gap-[14px]",children:[(0,Me.jsxs)("div",{className:"flex flex-col gap-2",children:[(0,Me.jsx)("span",{className:"font-circular text-[16px] text-dhq-text leading-[22px] tracking-[-0.1px]",children:a}),(0,Me.jsx)("span",{className:"font-dm font-medium text-[12px] t